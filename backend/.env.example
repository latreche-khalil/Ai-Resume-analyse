# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ai_resume.db
# For production: postgresql+asyncpg://user:password@localhost:5432/ai_resume

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-min-32-chars-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Providers ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GROK_API_KEY=your-grok-api-key
PUTER_AUTH_TOKEN=your-puter-token  # Get from https://puter.com/dashboard

# ── ClamAV ─────────────────────────────────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SKIP_VIRUS_SCAN=true  # Set false in production

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# ── File Upload ────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ── Email (Optional) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ── Sentry (Optional) ──────────────────────────────────────────────────────────
SENTRY_DSN=
